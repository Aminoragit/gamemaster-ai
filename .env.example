# Firebase web app config — from Firebase Console → Project settings.
# Copy this file to `.env.local` and fill in real values. `.env.local`
# is git-ignored; never commit real keys.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key). In local development the
# debug-token flow is used instead (see lib/appcheck.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
